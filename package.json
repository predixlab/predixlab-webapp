    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "postcss": "^8.4.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "^1.3.0"
